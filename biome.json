{
  "$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false, "includes": ["**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": { "level": "error", "fix": "safe" },
        "useExhaustiveDependencies": "off"
      },
      "complexity": { "noUselessFragments": "error", "noBannedTypes": "error" },
      "a11y": { "useButtonType": "off", "useKeyWithClickEvents": "off", "noSvgWithoutTitle": "off" },
      "style": {
        "noEnum": "error",
        "noNamespace": "error",
        "useDefaultSwitchClause": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        },
        "useNumericSeparators": "error"
      },
      "suspicious": { "noExplicitAny": "off", "noAlert": "error", "noVar": "error", "noEmptyInterface": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "recommended": true,
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:"],
              ":BLANK_LINE:",
              ["vue", "vue/**", "@vue/**"],
              [":PACKAGE:"],
              ":BLANK_LINE:",
              [":PATH:"]
            ],
            "identifierOrder": "lexicographic"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useFilenamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ]
}
