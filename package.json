{
  "name": "nuvra",
  "version": "0.3.0",
  "description": "Word-style document editor for Vue 3: page view, tables, images, find & replace, print and Word export.",
  "keywords": [
    "vue",
    "vue3",
    "editor",
    "rich-text",
    "wysiwyg",
    "document",
    "word",
    "document-editor"
  ],
  "license": "MIT",
  "author": "Eshonqul",
  "homepage": "https://nuvra-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshonqul6772/nuvra.git"
  },
  "bugs": {
    "url": "https://github.com/eshonqul6772/nuvra/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "run-s build:lib build:types",
    "build:lib": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "prepublishOnly": "run-s biome type-check build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
